der-top:1px solid rgba(255,255,255,.08);box-shadow:0 -5px 22px rgba(0,0,0,.24);font-family:system-ui,-apple-system,sans-serif}",
      "#rpa-app-bottom-nav button{position:relative;border:0;background:transparent;color:#9d9d9d;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;height:56px;font:500 11px system-ui,-apple-system,sans-serif}",
      "#rpa-app-bottom-nav button span{font-size:22px;line-height:1}#rpa-app-bottom-nav button b{font-weight:600}#rpa-app-bottom-nav button.active{color:#fff}#rpa-app-bottom-nav button.active span{transform:scale(1.05)}",
      "#rpa-music-playing-dot{position:absolute;top:5px;right:calc(50% - 20px);width:7px;height:7px;border-radius:50%;background:#d89245;box-shadow:0 0 8px rgba(216,146,69,.8)}",
      "#rpa-music-panel{position:fixed;left:0;right:0;top:0;bottom:calc(var(--rpa-bottom-nav-h) + env(safe-area-inset-bottom));z-index:2147483600;background:#111;color:#fff;font-family:system-ui,-apple-system,sans-serif;transform:translateX(105%);transition:transform .22s ease;overflow:hidden}",
      "#rpa-music-panel.open{transform:translateX(0)}.rpa-music-shell{height:100%;display:flex;flex-direction:column;overflow:hidden;background:linear-gradient(180deg,#2b1b12 0,#151515 260px,#111 520px)}",
      ".rpa-music-top{display:flex;align-items:center;justify-content:space-between;padding:18px 16px 8px;gap:12px}.rpa-kicker{display:block;color:#d8a166;font-weight:800;letter-spacing:.14em;font-size:9px}.rpa-music-top h1{margin:2px 0 0;font:800 27px/1.1 system-ui,-apple-system,sans-serif}.rpa-live-pill{border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#fff;border-radius:999px;padding:9px 11px;font:700 11px system-ui}",
      ".rpa-music-hero{margin:8px 14px 12px;padding:19px 17px;min-height:116px;border-radius:18px;display:flex;align-items:center;gap:14px;background:linear-gradient(135deg,#743f18,#b96d2d 58%,#dd9b55);box-shadow:0 12px 35px rgba(0,0,0,.28)}.rpa-hero-copy{flex:1}.rpa-hero-copy>span{font-size:10px;text-transform:uppercase;font-weight:800;letter-spacing:.1em;color:#ffe2c4}.rpa-hero-copy h2{font-size:22px;line-height:1.08;margin:5px 0 6px}.rpa-hero-copy p{font-size:12px;line-height:1.35;margin:0;color:#fff1e3}.rpa-hero-icon{width:70px;height:70px;border-radius:16px;display:grid;place-items:center;font-size:42px;background:rgba(20,10,4,.28);box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}",
      ".rpa-section-title{display:flex;align-items:flex-end;justify-content:space-between;padding:0 15px 9px}.rpa-section-title h3{margin:0;font-size:18px}.rpa-section-title span{font-size:11px;color:#aaa}.rpa-featured{display:flex;gap:12px;overflow-x:auto;padding:0 14px 16px;scrollbar-width:none}.rpa-featured::-webkit-scrollbar{display:none}.rpa-feature-card{flex:0 0 132px;border:0;background:transparent;color:#fff;text-align:left;padding:0}.rpa-feature-card img{display:block;width:132px;height:132px;object-fit:cover;border-radius:8px;background:#282828;box-shadow:0 7px 20px rgba(0,0,0,.28)}.rpa-feature-card b,.rpa-feature-card span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rpa-feature-card b{font-size:12px;margin-top:7px}.rpa-feature-card span{font-size:10px;color:#aaa;margin-top:2px}.rpa-card-skeleton{flex:0 0 132px;height:132px;border-radius:8px;background:linear-gradient(90deg,#282828,#333,#282828)}",
      ".rpa-music-search{margin:0 14px 10px;height:45px;border-radius:9px;background:#fff;color:#111;display:flex;align-items:center;padding:0 12px;gap:8px}.rpa-music-search span{font-size:23px}.rpa-music-search input{border:0;outline:0;background:transparent;width:100%;font:600 14px system-ui;color:#111}.rpa-music-search input::placeholder{color:#666}",
      ".rpa-music-tabs{display:flex;gap:8px;overflow:auto;padding:0 14px 10px;scrollbar-width:none}.rpa-music-tabs button,.rpa-playlist-bar button{white-space:nowrap;border:1px solid #464646;background:#222;color:#eee;border-radius:999px;padding:8px 12px;font:600 11px system-ui}.rpa-music-tabs button.active,.rpa-playlist-bar button.active{background:#fff;color:#111;border-color:#fff}.rpa-playlist-bar{display:flex;gap:7px;overflow:auto;padding:0 14px 9px;scrollbar-width:none}.rpa-list-heading{padding-top:1px}",
      ".rpa-track-list{flex:1;overflow:auto;padding:0 10px 105px}.rpa-music-loading,.rpa-music-empty{padding:35px 18px;text-align:center;color:#aaa;font-size:13px;line-height:1.5}.rpa-track{display:grid;grid-template-columns:54px minmax(0,1fr) auto;gap:11px;align-items:center;padding:7px 5px;border-radius:9px}.rpa-track:active{background:#242424}.rpa-track img{width:54px;height:54px;border-radius:6px;object-fit:cover;background:#282828}.rpa-track-copy{min-width:0}.rpa-track-copy b,.rpa-track-copy span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rpa-track-copy b{font-size:13px}.rpa-track-copy span{font-size:11px;color:#aaa;margin-top:3px}.rpa-track-actions{display:flex;align-items:center}.rpa-track-actions b