    (document.head || document.documentElement).appendChild(style);

    var trackList = document.getElementById("rpa-track-list");
    var searchInput = document.getElementById("rpa-music-search");
    var playlistBar = document.getElementById("rpa-playlist-bar");
    var mini = document.getElementById("rpa-music-mini");
    var progress = document.getElementById("rpa-mini-progress");
    var modal = document.getElementById("rpa-playlist-modal");
    var featured = document.getElementById("rpa-featured");
    var featuredSection = document.getElementById("rpa-featured-section");

    function playlistNames() {
      return Object.keys(library.playlists).sort(function (a, b) {
        return a.localeCompare(b, "pt-PT");
      });
    }

    function tracksForView() {
      var list = catalog.slice();
      if (activeView === "favorites") {
        var favs = new Set(library.favorites);
        list = list.filter(function (track) { return favs.has(track.id); });
      } else if (activeView.indexOf("playlist:") === 0) {
        var name = activeView.slice(9);
        var ids = new Set(library.playlists[name] || []);
        list = list.filter(function (track) { return ids.has(track.id); });
      } else if (activeView === "playlists") {
        list = [];
      }
      var query = String(searchInput.value || "").trim().toLocaleLowerCase("pt-PT");
      if (query) {
        list = list.filter(function (track) {
          return (track.title + " " + track.artist + " " + track.album)
            .toLocaleLowerCase("pt-PT").indexOf(query) >= 0;
        });
      }
      return list;
    }

    function renderFeatured() {
      var show = activeView === "all" && !String(searchInput.value || "").trim();
      featuredSection.style.display = show ? "block" : "none";
      if (!show) return;
      if (!catalogLoaded) {
        featured.innerHTML = "<div class='rpa-card-skeleton'></div><div class='rpa-card-skeleton'></div><div class='rpa-card-skeleton'></div>";
        return;
      }
      var items = catalog.slice(0, 8);
      featured.innerHTML = items.map(function (track) {
        return "<button type='button' class='rpa-feature-card' data-feature-id='" + escapeHtml(track.id) + "'><img src='" + escapeHtml(track.artwork) + "' alt=''><b>" + escapeHtml(track.title) + "</b><span>" + escapeHtml(track.artist) + "</span></button>";
      }).join("") || "<div class='rpa-music-empty'>Ainda não existem destaques.</div>";
    }

