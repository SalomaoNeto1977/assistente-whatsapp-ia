utton{border:0;background:transparent;color:#ddd;font-size:19px;padding:8px 6px}.rpa-track-actions .fav.on{color:#e3a158}",
      ".rpa-music-mini{position:absolute;left:7px;right:7px;bottom:7px;display:grid;grid-template-columns:50px minmax(0,1fr) auto;gap:9px;align-items:center;padding:7px;border-radius:9px;background:#5a351f;color:#fff;box-shadow:0 8px 28px rgba(0,0,0,.4);z-index:8}.rpa-music-mini[hidden]{display:none}.rpa-music-mini img{width:50px;height:50px;border-radius:5px;object-fit:cover}.rpa-mini-copy{min-width:0}.rpa-mini-copy b,.rpa-mini-copy span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rpa-mini-copy b{font-size:12px}.rpa-mini-copy span{font-size:10px;color:#ead7c7}.rpa-mini-copy input{width:100%;height:3px;margin-top:6px;accent-color:#fff}.rpa-mini-controls{display:flex}.rpa-mini-controls button{border:0;background:transparent;color:#fff;font-size:18px;padding:8px 6px}.rpa-mini-controls button:disabled{opacity:.35}",
      ".rpa-playlist-modal{position:absolute;inset:0;background:rgba(0,0,0,.72);display:grid;place-items:end center;padding:14px;z-index:20}.rpa-playlist-modal[hidden]{display:none}.rpa-playlist-modal>div{width:min(100%,520px);box-sizing:border-box;background:#242424;color:#fff;border-radius:18px;padding:16px;max-height:72vh;overflow:auto}.rpa-playlist-modal h3{margin:0 0 10px}.rpa-playlist-modal label{display:block;font-size:11px;color:#bbb;margin-top:12px}.rpa-playlist-modal input{box-sizing:border-box;width:100%;margin-top:5px;padding:11px;background:#333;color:#fff;border:1px solid #555;border-radius:8px}.rpa-playlist-option{display:block;width:100%;text-align:left;border:0;background:#333;color:#fff;border-radius:8px;padding:11px;margin:6px 0}.rpa-modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:12px}.rpa-modal-actions button{border:0;border-radius:999px;padding:9px 13px}.rpa-modal-actions #rpa-playlist-create{background:#fff;color:#111;font-weight:700}",
